{% liquid
  assign background_color = section.settings.background_color | default: '#1e5f5c'
  render 'contrast-override', background_color: background_color, section_id: section.id, skip_contrast: true
%}

<div
  class="section-background color-custom-{{ section.id }}"
></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style beaverkeys-reviews color-custom-{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="beaverkeys-reviews__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="beaverkeys-reviews__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="beaverkeys-reviews__grid">
      {% content_for 'blocks' %}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .beaverkeys-reviews {
    padding-block: 80px;
  }

  .beaverkeys-reviews__heading {
    font: 800 32px var(--font-heading--family);
    color: #86cbc8;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }

  .beaverkeys-reviews__subheading {
    font: 500 14px var(--font-body--family);
    color: rgb(134 203 200 / 0.6);
    margin: 0 0 36px;
  }

  .beaverkeys-reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .beaverkeys-reviews__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .beaverkeys-reviews__card {
    background: rgb(255 255 255 / 0.06);
    border-radius: 16px;
    padding: 28px;
  }

  .beaverkeys-reviews__stars {
    color: #86cbc8;
    font-size: 15px;
    letter-spacing: 2px;
    margin-block-end: 14px;
  }

  .beaverkeys-reviews__quote {
    font: 500 14px/1.6 var(--font-body--family);
    color: #f5eedd;
    margin: 0 0 18px;
  }

  .beaverkeys-reviews__name {
    font: 700 13px var(--font-heading--family);
    color: #86cbc8;
    margin: 0;
  }

  .beaverkeys-reviews__product {
    font: 400 12px var(--font-body--family);
    color: rgb(134 203 200 / 0.5);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.beaverkeys_reviews",
  "tag": "section",
  "class": "beaverkeys-reviews-wrapper section-wrapper",
  "blocks": [
    {
      "type": "_beaverkeys-review"
    }
  ],
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Customers love us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "378 five-star reviews"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#1e5f5c"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.beaverkeys_reviews",
      "category": "t:categories.storytelling",
      "blocks": {
        "review_1": {
          "type": "_beaverkeys-review",
          "settings": {
            "rating": 5,
            "quote": "Fast shipping and Peter gave me personal help picking switches. Great experience.",
            "name": "Salar M.",
            "product": "Keygeek Y2"
          }
        },
        "review_2": {
          "type": "_beaverkeys-review",
          "settings": {
            "rating": 5,
            "quote": "My favourite switches for non-silent — snappy return, weight is just right.",
            "name": "Brandon C.",
            "product": "Weikav Stars21"
          }
        },
        "review_3": {
          "type": "_beaverkeys-review",
          "settings": {
            "rating": 5,
            "quote": "Great keycaps, good price, and fast shipping.",
            "name": "Manuel B.",
            "product": "Gateron Mini I"
          }
        }
      },
      "block_order": ["review_1", "review_2", "review_3"]
    }
  ]
}
{% endschema %}
