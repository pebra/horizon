{% liquid
  assign page_resource = closest.page
  assign heading = section.settings.heading | default: page_resource.title

  assign end_timestamp = section.settings.end_time | date: '%s' | plus: 0
  assign now_timestamp = 'now' | date: '%s' | plus: 0
  assign remaining = end_timestamp | minus: now_timestamp
  if remaining < 0 or end_timestamp == 0
    assign remaining = 0
  endif

  assign days = remaining | divided_by: 86400
  assign hours = remaining | modulo: 86400 | divided_by: 3600
  assign minutes = remaining | modulo: 3600 | divided_by: 60
  assign seconds = remaining | modulo: 60
%}

<script
  src="{{ 'beaverkeys-countdown.js' | asset_url }}"
  type="module"
></script>

<div class="section beaverkeys-countdown-section">
  <beaverkeys-countdown-component
    class="beaverkeys-countdown"
    data-end-time="{{ section.settings.end_time | escape }}"
    data-state="{% if remaining > 0 %}counting{% else %}live{% endif %}"
  >
    <div
      class="beaverkeys-countdown__ribbon"
      aria-hidden="true"
    >
      <span class="beaverkeys-countdown__ribbon-track">
        {%- for i in (1..8) -%}
          <span>{{ section.settings.ribbon_text }}</span>
        {%- endfor -%}
      </span>
    </div>

    <div class="beaverkeys-countdown__content">
      {% if section.settings.badge != blank %}
        <p class="beaverkeys-countdown__badge">{{ section.settings.badge }}</p>
      {% endif %}

      <h1 class="beaverkeys-countdown__heading">{{ heading }}</h1>

      <div
        class="beaverkeys-countdown__timer"
        role="timer"
        aria-label="{{ 'accessibility.beaverkeys_countdown' | t }}"
        ref="timer"
        {% if remaining == 0 %}
          hidden
        {% endif %}
      >
        <div
          class="beaverkeys-countdown__unit"
          ref="daysUnit"
          {% if days == 0 %}
            hidden
          {% endif %}
        >
          <span
            class="beaverkeys-countdown__key"
            ref="days"
          >
            {{- days | prepend: '0' | slice: -2, 2 -}}
          </span>
          <span class="beaverkeys-countdown__label">{{ 'content.beaverkeys_countdown_days' | t }}</span>
        </div>
        <div class="beaverkeys-countdown__unit">
          <span
            class="beaverkeys-countdown__key"
            ref="hours"
          >
            {{- hours | prepend: '0' | slice: -2, 2 -}}
          </span>
          <span class="beaverkeys-countdown__label">{{ 'content.beaverkeys_countdown_hours' | t }}</span>
        </div>
        <div class="beaverkeys-countdown__unit">
          <span
            class="beaverkeys-countdown__key"
            ref="minutes"
          >
            {{- minutes | prepend: '0' | slice: -2, 2 -}}
          </span>
          <span class="beaverkeys-countdown__label">{{ 'content.beaverkeys_countdown_minutes' | t }}</span>
        </div>
        <div class="beaverkeys-countdown__unit">
          <span
            class="beaverkeys-countdown__key beaverkeys-countdown__key--accent"
            ref="seconds"
          >
            {{- seconds | prepend: '0' | slice: -2, 2 -}}
          </span>
          <span class="beaverkeys-countdown__label">{{ 'content.beaverkeys_countdown_seconds' | t }}</span>
        </div>
      </div>

      <p
        class="beaverkeys-countdown__live"
        role="status"
        ref="liveMessage"
        {% if remaining > 0 %}
          hidden
        {% endif %}
      >
        {{ section.settings.live_message }}
      </p>

      {% if page_resource.content != blank %}
        <div class="beaverkeys-countdown__body rte">
          {{ page_resource.content }}
        </div>
      {% endif %}
    </div>
  </beaverkeys-countdown-component>
</div>

{% stylesheet %}
  .beaverkeys-countdown-section {
    padding-block: 40px 80px;
  }

  .beaverkeys-countdown {
    --beaverkeys-countdown-ink: #0e2524;
    --beaverkeys-countdown-cream: #f5eedd;
    --beaverkeys-countdown-teal: #86cbc8;
    --beaverkeys-countdown-orange: #ff885d;

    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 24px;
    color: var(--beaverkeys-countdown-cream);
    background:
      radial-gradient(circle at 85% 15%, rgb(255 136 93 / 0.35), transparent 45%),
      radial-gradient(circle at 10% 90%, rgb(134 203 200 / 0.25), transparent 50%),
      linear-gradient(160deg, #1e5f5c 0%, var(--beaverkeys-countdown-ink) 65%);
    padding: 96px 24px 56px;
    isolation: isolate;
  }

  @media screen and (min-width: 750px) {
    .beaverkeys-countdown {
      padding: 120px 60px 80px;
    }
  }

  .beaverkeys-countdown::before,
  .beaverkeys-countdown::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 18px;
    border: 2px solid rgb(134 203 200 / 0.18);
    box-shadow: 0 10px 0 rgb(134 203 200 / 0.08);
    pointer-events: none;
  }

  .beaverkeys-countdown::before {
    width: 180px;
    height: 180px;
    bottom: -50px;
    right: -30px;
    rotate: -14deg;
  }

  .beaverkeys-countdown::after {
    width: 110px;
    height: 110px;
    top: 38%;
    left: -40px;
    rotate: 18deg;
  }

  .beaverkeys-countdown__ribbon {
    position: absolute;
    top: 28px;
    left: -10%;
    width: 120%;
    rotate: -3deg;
    overflow: hidden;
    background: var(--beaverkeys-countdown-orange);
    color: var(--beaverkeys-countdown-ink);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
  }

  .beaverkeys-countdown__ribbon-track {
    display: flex;
    gap: 28px;
    width: max-content;
    padding: 10px 0;
    font: 800 13px/1 var(--font-heading--family);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .beaverkeys-countdown__ribbon-track span::after {
    content: '\2605';
    margin-inline-start: 28px;
  }

  .beaverkeys-countdown__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
  }

  .beaverkeys-countdown__badge {
    display: inline-block;
    background: var(--beaverkeys-countdown-cream);
    color: var(--beaverkeys-countdown-ink);
    font: 700 12px/1 var(--font-heading--family);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 20px;
    margin: 0 0 22px;
  }

  .beaverkeys-countdown__heading {
    font: 800 40px/0.98 var(--font-heading--family);
    color: var(--beaverkeys-countdown-cream);
    letter-spacing: -0.03em;
    text-wrap: balance;
    margin: 0 0 40px;
  }

  @media screen and (min-width: 750px) {
    .beaverkeys-countdown__heading {
      font-size: 68px;
    }
  }

  .beaverkeys-countdown__timer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-block-end: 44px;
  }

  @media screen and (min-width: 750px) {
    .beaverkeys-countdown__timer {
      gap: 22px;
    }
  }

  .beaverkeys-countdown__timer[hidden],
  .beaverkeys-countdown__unit[hidden],
  .beaverkeys-countdown__live[hidden] {
    display: none;
  }

  .beaverkeys-countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .beaverkeys-countdown__key {
    --beaverkeys-countdown-key-skirt: #c9bd9f;

    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: 14px;
    background: linear-gradient(180deg, #fffaf0 0%, var(--beaverkeys-countdown-cream) 100%);
    color: var(--beaverkeys-countdown-ink);
    font: 800 30px/1 var(--font-heading--family);
    font-variant-numeric: tabular-nums;
    box-shadow:
      inset 0 -3px 0 rgb(14 37 36 / 0.08),
      0 7px 0 var(--beaverkeys-countdown-key-skirt),
      0 14px 24px rgb(0 0 0 / 0.35);
  }

  @media screen and (min-width: 750px) {
    .beaverkeys-countdown__key {
      width: 104px;
      height: 104px;
      border-radius: 18px;
      font-size: 46px;
    }
  }

  .beaverkeys-countdown__key--accent {
    --beaverkeys-countdown-key-skirt: #c8603c;

    background: linear-gradient(180deg, #ffa27f 0%, var(--beaverkeys-countdown-orange) 100%);
  }

  .beaverkeys-countdown__label {
    font: 700 11px/1 var(--font-heading--family);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--beaverkeys-countdown-teal);
  }

  .beaverkeys-countdown__live {
    font: 800 28px/1.1 var(--font-heading--family);
    color: var(--beaverkeys-countdown-orange);
    margin: 0 0 44px;
  }

  .beaverkeys-countdown__body {
    --color-foreground: var(--beaverkeys-countdown-cream);
    --color-foreground-rgb: 245 238 221;
    --color-foreground-heading: var(--beaverkeys-countdown-teal);

    max-width: 560px;
    color: var(--beaverkeys-countdown-cream);
    font: 400 16px/1.7 var(--font-body--family);
  }

  .beaverkeys-countdown__body :is(h1, h2, h3, h4) {
    font-family: var(--font-heading--family);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.01em;
    color: var(--beaverkeys-countdown-teal);
  }

  .beaverkeys-countdown__body strong {
    color: var(--beaverkeys-countdown-orange);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.beaverkeys_countdown",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "end_time",
      "label": "t:settings.beaverkeys_countdown_end",
      "info": "t:info.beaverkeys_countdown_end",
      "default": "2026-11-22T19:00:00-05:00"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:settings.beaverkeys_badge_label",
      "default": "Black Friday · Cyber Monday"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:info.beaverkeys_heading_page_title"
    },
    {
      "type": "text",
      "id": "ribbon_text",
      "label": "t:settings.beaverkeys_ribbon_text",
      "default": "Black Friday · Cyber Monday"
    },
    {
      "type": "text",
      "id": "live_message",
      "label": "t:settings.beaverkeys_live_message",
      "default": "The sale is live!"
    }
  ],
  "presets": [
    {
      "name": "t:names.beaverkeys_countdown",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
